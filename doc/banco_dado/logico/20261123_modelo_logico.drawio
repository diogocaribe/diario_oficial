        <mxCell id="vw_publicacao" value="&lt;b&gt;public.vw_publicacao (VIEW)&lt;/b&gt;&lt;br&gt;publicacao + doe_bruto + dominio.*" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1180" y="780" width="340" height="70" as="geometry" /></mxCell>
        <mxCell id="vw_ato" value="&lt;b&gt;public.vw_ato (VIEW)&lt;/b&gt;&lt;br&gt;ato + publicacao (auditoria IS TRUE) + doe_bruto&lt;br&gt;+ dominio.* + tipo_ato e sigla_tipo_ato (juntos por &#x27;; &#x27;)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1180" y="870" width="340" height="70" as="geometry" /></mxCell>
        <mxCell id="nota_trigger" value="&lt;b&gt;Trigger&lt;/b&gt; after_delete_delete_atos_da_mesma_pubalicacao&lt;br&gt;AFTER DELETE ON processing.ato: apaga os demais atos da mesma publicação e faz publicacao.processada_para_ato = NULL." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="960" width="320" height="110" as="geometry" /></mxCell>
        <mxCell id="nota_ck" value="&lt;b&gt;CHECK&lt;/b&gt; ck_log_erro_etapa:&lt;br&gt;etapa IN (&#x27;separacao&#x27;, &#x27;auditoria&#x27;)" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1180" y="700" width="340" height="60" as="geometry" /></mxCell>
        <mxCell id="nota_auto" value="&lt;b&gt;Herança joined-table&lt;/b&gt;: cada auto_* tem PK = FK para auto_infracao.id (ON DELETE CASCADE), e tipo_auto guarda a tabela do subtipo.&lt;br&gt;&lt;b&gt;Geometrias&lt;/b&gt; ponto e poligono em SIRGAS 2000 (SRID 4674), com índice GIST; o datum original fica em sistema_referencia_espacial.&lt;br&gt;&lt;b&gt;Único parcial&lt;/b&gt; uq_pessoa_documento (tipo_documento, nro_documento) WHERE nro_documento IS NOT NULL.&lt;br&gt;bem_produto_autuado: bens do AIAP e produtos do AIDP.&lt;br&gt;&lt;b&gt;Trigger&lt;/b&gt; after_delete_apagar_endereco_do_auto: AFTER DELETE ON auto_infracao apaga os endereços do auto (local_infracao_id e endereco_autuado_id). A pessoa continua." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="2150" width="400" height="230" as="geometry" /></mxCell>
        <mxCell id="nota_ck_auto" value="&lt;b&gt;CHECK&lt;/b&gt; do esquema auto_infracao:&lt;br&gt;auto_infracao.natureza IN (&#x27;homologacao&#x27;, &#x27;recurso&#x27;, &#x27;termo_de_compromisso&#x27;, &#x27;sustacao&#x27;, &#x27;outro&#x27;)&lt;br&gt;auto_infracao.resultado_recurso IN (&#x27;deferido&#x27;, &#x27;indeferido&#x27;)&lt;br&gt;auto_infracao.gravidade IN (&#x27;leve&#x27;, &#x27;grave&#x27;, &#x27;gravissima&#x27;)&lt;br&gt;public.pessoa.tipo_documento IN (&#x27;CPF&#x27;, &#x27;CNPJ&#x27;, &#x27;RG&#x27;)&lt;br&gt;auto_interdicao.modalidade IN (&#x27;temporaria&#x27;, &#x27;definitiva&#x27;)&lt;br&gt;auto_embargo.modalidade IN (&#x27;temporario&#x27;, &#x27;definitivo&#x27;)&lt;br&gt;auto_multa.tipo_multa IN (&#x27;simples&#x27;, &#x27;diaria&#x27;)&lt;br&gt;auto_destruicao_fornos.situacao_forno IN (&#x27;ativo&#x27;, &#x27;inativo&#x27;)&lt;br&gt;coordenada_extraida_trecho.tipo IN (&#x27;ponto&#x27;, &#x27;vertice&#x27;)" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="2140" width="500" height="190" as="geometry" /></mxCell>
        <mxCell id="legenda" value="&lt;b&gt;Legenda&lt;/b&gt; &amp;nbsp; Azul: esquema &lt;i&gt;dominio&lt;/i&gt; (lookup, carregado por migração) &amp;nbsp;|&amp;nbsp; Verde: esquema &lt;i&gt;processing&lt;/i&gt; &amp;nbsp;|&amp;nbsp; Roxo: esquema &lt;i&gt;auto_infracao&lt;/i&gt; (dados extraídos dos atos com LLM, PostGIS) &amp;nbsp;|&amp;nbsp; Amarelo: tabelas em &lt;i&gt;public&lt;/i&gt;, comuns às extrações &amp;nbsp;|&amp;nbsp; Cinza: views em &lt;i&gt;public&lt;/i&gt;.&lt;br&gt;PK = chave primária, FK = chave estrangeira, UK = único, CK = check. FKs para dominio.* sem ON DELETE explícito (NO ACTION)." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="2500" width="1480" height="70" as="geometry" /></mxCell>
        <mxCell id="rel0" value="ON DELETE CASCADE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=ERzeroToMany;startFill=0;endArrow=ERmandOne;endFill=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="publicacao_r1" target="doe_bruto_r0"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell>
